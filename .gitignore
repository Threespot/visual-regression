# Dependencies
node_modules/

# Yarn 4 (Berry)
# Keep version-controlled: patches, plugins, releases, SDKs, version drafts.
# Ignore the rest (cache, install state, PnP files).
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# npm (legacy — keeping ignored in case someone runs npm by accident)
package-lock.json

# Playwright output
visual-regression/playwright-report/
visual-regression/test-results/
blob-report/
playwright/.cache/

# Environment / secrets
.env
.env.*
!.env.example
.envrc
auth.json

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local
*.local
tmp/
.cache/
